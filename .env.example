# HeritageGuardian AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── IBM GRANITE / WATSONX ───────────────────────────────────────────────────
# IBM Granite API key (direct) OR IBM Cloud API key (for IAM token exchange)
GRANITE_API_KEY=
IBM_CLOUD_API_KEY=
IBM_PROJECT_ID=

# Granite model and endpoint (defaults shown)
GRANITE_MODEL=ibm/granite-13b-instruct-v2
GRANITE_API_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation?version=2023-05-29

# ─── DATABASE ────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./heritageguardian.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/heritageguardian

# ─── APPLICATION ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Frontend allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File uploads
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE_MB=10

# ─── IBM CLOUD SERVICES (optional — enable as needed) ────────────────────────
# IBM Cloud Object Storage (for image persistence)
IBM_COS_ENDPOINT=
IBM_COS_API_KEY=
IBM_COS_BUCKET=

# IBM Watson Visual Recognition (production CV replacement)
IBM_WATSON_VISION_API_KEY=
IBM_WATSON_VISION_URL=

# IBM Cloud Monitoring
IBM_MONITORING_GUID=
IBM_MONITORING_KEY=

# ─── DEMO MODE ───────────────────────────────────────────────────────────────
# Set to true to always use simulated data regardless of IBM API availability
DEMO_MODE=false
