# IBM Granite (watsonx.ai) — required for AI-enhanced responses
IBM_API_KEY=your-ibm-cloud-api-key
GRANITE_ENDPOINT=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id
GRANITE_MODEL=ibm/granite-3-3-8b-instruct

# Database (defaults to SQLite in development)
DATABASE_URL=sqlite:///./heritage.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/heritage

# Application
APP_ENV=demo
DB_ECHO=false

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
